# System Configuration
PROJECT_NAME="Multimodal Autonomous Customer Support Agent"
API_V1_STR="/api/v1"

# Database (PostgreSQL) Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=customer_support_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# Cache & Message Broker (Redis) Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000

# Security & JWT Configuration
SECRET_KEY=super_secret_jwt_key_for_development_change_in_production
AGENT_SERVICE_SECRET=agent_internal_service_secret_key_2026

# ==============================================================================
# LLM Intent Recognition & Entity Extraction API Keys
# ==============================================================================
# Choose your provider: "gemini", "openai", or "mock" (offline rule-based mode)
LLM_PROVIDER=gemini

# --- GOOGLE GEMINI (Recommended) ---
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# --- OPENAI (Optional / Alternative) ---
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1

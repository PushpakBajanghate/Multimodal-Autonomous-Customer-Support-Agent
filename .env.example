# System Configuration
PROJECT_NAME="Multimodal Autonomous Customer Support Agent"
API_V1_STR="/api/v1"

# Database (PostgreSQL) Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=customer_support_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435

# Cache & Message Broker (Redis) Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Frontend Configuration
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_HEALTH_URL=http://localhost:8000/health

# Security & JWT Configuration
SECRET_KEY=super_secret_jwt_key_for_development_change_in_production
AGENT_SERVICE_SECRET=agent_internal_service_secret_key_2026

# ==============================================================================
# LLM Intent Recognition & Entity Extraction API Keys
# ==============================================================================
# Choose your provider: "gemini", "openai", or "mock" (offline rule-based mode).
# Set GEMINI_API_KEY to a real key to enable live, contextual Gemini replies.
LLM_PROVIDER=gemini

# --- GOOGLE GEMINI (Recommended) ---
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-3.7-flash

# --- OPENAI (Optional / Alternative) ---
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=PASTE_YOUR_OPENAI_API_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

LLM_TEMPERATURE=0.1

# ==============================================================================
# Human Voice + Outbound Phone Calling
# ==============================================================================
# Voice provider for generated agent audio: "sarvam", "elevenlabs", or "browser".
VOICE_PROVIDER=sarvam

# Public HTTPS URL for Twilio webhooks, e.g. an ngrok URL during local testing.
PUBLIC_BASE_URL=

# Sarvam AI: recommended for Hindi, Indian English, and Hinglish voice.
SARVAM_API_KEY=PASTE_YOUR_SARVAM_API_KEY_HERE
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_HINDI_SPEAKER=anushka
SARVAM_ENGLISH_SPEAKER=shubh
SARVAM_OUTPUT_CODEC=wav
SARVAM_SAMPLE_RATE=24000

# ElevenLabs: alternative multilingual, human-like TTS provider.
ELEVENLABS_API_KEY=PASTE_YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Twilio outbound calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==============================================================================
# Multimodal Autonomous Customer Support Agent - Environment Configuration
# ==============================================================================

# Core System & Database
DATABASE_URL=sqlite:///./macs.db
PROJECT_NAME="Multimodal Autonomous Customer Support Agent"
API_V1_STR="/api/v1"
SECRET_KEY=super_secret_jwt_key_for_development_change_in_production
AGENT_SERVICE_SECRET=agent_internal_service_secret_key_2026

# Frontend URLs
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_HEALTH_URL=http://localhost:8000/health

# ==============================================================================
# LLM Intent Recognition & Conversational AI (Google Gemini / OpenAI)
# ==============================================================================
# Provider options: "gemini", "openai", or "mock"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_TEMPERATURE=0.2

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Voice Synthesis (Sarvam AI / ElevenLabs / Browser)
# ==============================================================================
# Voice provider options: "sarvam", "elevenlabs", or "browser"
VOICE_PROVIDER=sarvam

# Sarvam AI: Real Indian English, Hindi, and Hinglish TTS (Bulbul v3)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_HINDI_SPEAKER=ritu
SARVAM_ENGLISH_SPEAKER=shubh
SARVAM_OUTPUT_CODEC=wav
SARVAM_SAMPLE_RATE=24000

# ElevenLabs: Alternative global multilingual TTS
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ==============================================================================
# Telephony & Outbound/Inbound Calls (Twilio + Webhook Tunnel)
# ==============================================================================
# Public HTTPS URL for Twilio webhooks (e.g. https://your-domain.ngrok-free.app or Cloudflare tunnel)
PUBLIC_BASE_URL=

# Twilio Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ==============================================================================
# Multimodal Autonomous Customer Support Agent - Environment Configuration
# ==============================================================================

# Core System & Database
# Local default: leave DATABASE_URL empty to use backend/macs.db (SQLite).
# Docker Compose sets DATABASE_URL automatically to its Postgres service.
DATABASE_URL=
APP_ENV=development
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me
POSTGRES_DB=customer_support_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
PROJECT_NAME="Multimodal Autonomous Customer Support Agent"
API_V1_STR="/api/v1"
SECRET_KEY=super_secret_jwt_key_for_development_change_in_production
AGENT_SERVICE_SECRET=agent_internal_service_secret_key_2026

# Frontend URLs
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
NEXT_PUBLIC_HEALTH_URL=http://localhost:8000/health
# In Vercel, set these to the public Render service, for example:
# NEXT_PUBLIC_API_BASE=https://<render-service>.onrender.com/api/v1
# NEXT_PUBLIC_HEALTH_URL=https://<render-service>.onrender.com/health

# ==============================================================================
# LLM Intent Recognition & Conversational AI (Google Gemini / OpenAI)
# ==============================================================================
# Provider options: "gemini", "openai", or "mock"
# Use mock for an offline local run; switch to gemini/openai when credentials are configured.
LLM_PROVIDER=mock
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
LLM_TEMPERATURE=0.2

# 4-Tier LLM Architecture for Low-Latency & High-Resilience:
# Tier 1: Primary fast Cloud LLM (Gemini 3.6 Flash)
LLM_TIER1_MODEL=gemini-3.6-flash
LLM_TIER1_TIMEOUT=3.5

# Tier 2: Resilient Cloud Fallback (Gemini Flash Latest / OpenAI)
LLM_TIER2_MODEL=gemini-flash-latest
LLM_TIER2_TIMEOUT=3.5

# Tier 3: Ultra-Lite Cloud LLM (Gemini 3.1 Flash Lite)
LLM_TIER3_MODEL=gemini-3.1-flash-lite
LLM_TIER3_TIMEOUT=2.5

# Tier 4: Context-Aware Dynamic Adaptive Synthesis Engine (Local instant fallback)

# Optional OpenAI fallback (can serve as Tier 2)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Voice Synthesis (Sarvam AI / ElevenLabs / Browser)
# ==============================================================================
# Voice provider options: "sarvam", "elevenlabs", or "browser"
VOICE_PROVIDER=sarvam

# Sarvam AI: Real Indian English, Hindi, and Hinglish TTS (Bulbul v3)
SARVAM_API_KEY=YOUR_SARVAM_API_KEY_HERE
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_HINDI_SPEAKER=ritu
SARVAM_ENGLISH_SPEAKER=shubh
SARVAM_OUTPUT_CODEC=wav
SARVAM_SAMPLE_RATE=24000

# ElevenLabs: Alternative global multilingual TTS
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Browser voice support uses your ElevenLabs Conversational AI agent.
# Set ELEVENLABS_AGENT_ID and an API key with access to that agent on the backend.
# Enable agent authentication (signed URL) in ElevenLabs; never expose the API key to NEXT_PUBLIC_*.

# ==============================================================================
# Telephony & Outbound/Inbound Calls (Twilio + Webhook Tunnel)
# ==============================================================================
# Public HTTPS URL for Twilio webhooks (e.g. https://your-domain.ngrok-free.app or Cloudflare tunnel)
PUBLIC_BASE_URL=

# Twilio Credentials
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
